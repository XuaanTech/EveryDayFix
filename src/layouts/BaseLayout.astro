---
import SearchBar from '../components/SearchBar.astro';
import Logo from '../components/Logo.astro';
import Analytics from '../components/Analytics.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { SITE_NAME, SITE_URL } from '../lib/site.js';

interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  ogImage?: string;
  ogType?: string;
  showSearch?: boolean;
  noindex?: boolean;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
  articleSection?: string;
}

const defaultCanonicalURL = new URL(Astro.url.pathname, SITE_URL).href;
const defaultOgImage = new URL('/og-default.png', SITE_URL).href;

const {
  title,
  description,
  canonicalURL = defaultCanonicalURL,
  ogImage = defaultOgImage,
  ogType = 'website',
  showSearch = true,
  noindex = false,
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  articleSection,
} = Astro.props;

const siteName = SITE_NAME;
const siteUrl = SITE_URL;
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;

// Determine active nav path
const currentPath = Astro.url.pathname;
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/home-living/', label: 'Home & Living' },
  { href: '/tech-internet/', label: 'Tech' },
  { href: '/kitchen-food/', label: 'Kitchen' },
  { href: '/everyday-life/', label: 'Everyday' },
  { href: '/about/', label: 'About' },
];

// Site-wide Organization schema (enhances brand authority and Knowledge Panel)
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteUrl}/#organization`,
  "name": siteName,
  "url": siteUrl,
  "description": "Simple solutions for everyday problems. Practical tips, tricks, and step-by-step guides for home, tech, kitchen, and daily life.",
  "logo": {
    "@type": "ImageObject",
    "url": `${siteUrl}/logo.png`,
    "width": 180,
    "height": 180,
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer support",
    "email": "xuaninformatica@gmail.com",
    "areaServed": "Worldwide",
    "availableLanguage": "English",
  },
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="robots" content={`${noindex ? 'noindex, nofollow' : 'index, follow'}, max-image-preview:large, max-snippet:-1, max-video-preview:-1`} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="sitemap" href={new URL('sitemap-index.xml', siteUrl).href} />
  <link rel="alternate" hreflang="en" href={canonicalURL} />
  <link rel="alternate" hreflang="x-default" href={canonicalURL} />
  <meta name="theme-color" content="#2563eb" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="en_US" />
  {ogType === 'article' && articlePublishedTime && (
    <meta property="article:published_time" content={articlePublishedTime} />
  )}
  {ogType === 'article' && articleModifiedTime && (
    <meta property="article:modified_time" content={articleModifiedTime} />
  )}
  {ogType === 'article' && articleAuthor && (
    <meta property="article:author" content={articleAuthor} />
  )}
  {ogType === 'article' && articleSection && (
    <meta property="article:section" content={articleSection} />
  )}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <title>{fullTitle}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" type="application/rss+xml" title="EverydayFix RSS" href={new URL('rss.xml', siteUrl).href} />

  <!-- Rendering-friendly CSS (Astro bundles these at build time) -->
  <style is:global>
    @import '../styles/global.css';
    @import '../styles/components.css';
  </style>

  <!-- Site-wide structured data -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

  <!-- Google Analytics 4 (consent-gated, see component docs) -->
  <Analytics />
</head>
<body>
  <header class="header">
    <div class="container header__inner">
      <a href="/" class="header__logo" aria-label="EverydayFix Home">
        <Logo className="header__logo-icon" size={48} />
        <span>EverydayFix</span>
      </a>

      <button class="header__menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="main-nav" id="menu-toggle">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 12h18M3 6h18M3 18h18" />
        </svg>
      </button>

      <nav class="header__nav" id="main-nav" aria-label="Main navigation">
        {navLinks.map((link) => {
          const isActive = link.href === '/'
            ? currentPath === '/'
            : currentPath.startsWith(link.href);
          return (
            <a
              href={link.href}
              data-astro-prefetch="hover"
              class={`header__nav-link ${isActive ? 'header__nav-link--active' : ''}`}
              aria-current={isActive ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })}
      </nav>
    </div>
    {showSearch && (
      <div class="container header__search">
        <SearchBar />
      </div>
    )}
  </header>

  <main>
    <slot />
  </main>

  <footer class="footer">
    <div class="container">
      <div class="footer__grid">
        <div class="footer__brand">
          <div class="footer__brand-name">
            <Logo className="header__logo-icon" size={28} />
            EverydayFix
          </div>
          <p class="footer__brand-desc">
            Simple solutions for everyday problems. Practical tips, tricks, and guides to make your daily life easier.
          </p>
        </div>
        <div>
          <h3 class="footer__heading">Categories</h3>
          <div class="footer__links">
            <a href="/home-living/" class="footer__link">Home & Living</a>
            <a href="/tech-internet/" class="footer__link">Tech & Internet</a>
            <a href="/kitchen-food/" class="footer__link">Kitchen & Food</a>
            <a href="/everyday-life/" class="footer__link">Everyday Life</a>
          </div>
        </div>
        <div>
          <h3 class="footer__heading">Site</h3>
          <div class="footer__links">
            <a href="/about/" class="footer__link">About Us</a>
            <a href="/contact/" class="footer__link">Contact</a>
            <a href="/docs/" class="footer__link">Documentation</a>
            <button type="button" class="footer__link footer__link--button" data-consent-open>
              Cookie Settings
            </button>
            <a href="/privacy-policy/" class="footer__link">Privacy Policy</a>
            <a href="/disclaimer/" class="footer__link">Disclaimer</a>
            <a href="/rss.xml" class="footer__link">RSS Feed</a>
            <a href="mailto:xuaninformatica@gmail.com" class="footer__link">xuaninformatica@gmail.com</a>
          </div>
        </div>
      </div>
      <div class="footer__bottom">
        &copy; {new Date().getFullYear()} EverydayFix. All rights reserved.
      </div>
    </div>
  </footer>

  <script>
    const toggle = document.getElementById('menu-toggle');
    const nav = document.getElementById('main-nav');

    function closeMenu() {
      if (!toggle || !nav) return;
      nav.classList.remove('header__nav--open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open menu');
    }

    toggle?.addEventListener('click', () => {
      const isOpen = nav?.classList.toggle('header__nav--open') ?? false;
      toggle.setAttribute('aria-expanded', String(isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
    });

    nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeMenu();
    });
  </script>

  <!-- Cookie consent banner + preferences panel -->
  <CookieConsent />
</body>
</html>