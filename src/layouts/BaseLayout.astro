---
import SearchBar from '../components/SearchBar.astro';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  ogImage?: string;
  ogType?: string;
  showSearch?: boolean;
}

const {
  title,
  description,
  canonicalURL = Astro.url.href,
  ogImage = 'https://everydayfix.pages.dev/og-default.png',
  ogType = 'website',
  showSearch = true,
} = Astro.props;

const siteName = 'EverydayFix';
const siteUrl = 'https://everydayfix.pages.dev';
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;

// Determine active nav path
const currentPath = Astro.url.pathname;
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/home-living/', label: 'Home & Living' },
  { href: '/tech-internet/', label: 'Tech' },
  { href: '/kitchen-food/', label: 'Kitchen' },
  { href: '/everyday-life/', label: 'Everyday' },
  { href: '/about/', label: 'About' },
];

// Site-wide Organization schema (enhances brand authority and Knowledge Panel)
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteUrl}/#organization`,
  "name": siteName,
  "url": siteUrl,
  "description": "Simple solutions for everyday problems. Practical tips, tricks, and step-by-step guides for home, tech, kitchen, and daily life.",
  "logo": {
    "@type": "ImageObject",
    "url": `${siteUrl}/og-default.png`,
    "width": 1200,
    "height": 630,
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer support",
    "email": "xuaninformatica@gmail.com",
    "areaServed": "Worldwide",
    "availableLanguage": "English",
  },
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <link rel="canonical" href={canonicalURL} />
  <meta name="theme-color" content="#2563eb" />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <title>{fullTitle}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <!-- Rendering-friendly CSS (Astro bundles these at build time) -->
  <style is:global>
    @import '../styles/global.css';
    @import '../styles/components.css';
  </style>

  <!-- Site-wide structured data -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
</head>
<body>
  <header class="header">
    <div class="container header__inner">
      <a href="/" class="header__logo" aria-label="EverydayFix Home">
        <Logo className="header__logo-icon" size={48} />
        <span>EverydayFix</span>
      </a>

      <button class="header__menu-btn" aria-label="Toggle menu" id="menu-toggle">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 12h18M3 6h18M3 18h18" />
        </svg>
      </button>

      <nav class="header__nav" id="main-nav" aria-label="Main navigation">
        {navLinks.map((link) => {
          const isActive = link.href === '/'
            ? currentPath === '/'
            : currentPath.startsWith(link.href);
          return (
            <a
              href={link.href}
              data-astro-prefetch="hover"
              class={`header__nav-link ${isActive ? 'header__nav-link--active' : ''}`}
              aria-current={isActive ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })}
      </nav>
    </div>
    {showSearch && (
      <div class="container header__search">
        <SearchBar />
      </div>
    )}
  </header>

  <main>
    <slot />
  </main>

  <footer class="footer">
    <div class="container">
      <div class="footer__grid">
        <div class="footer__brand">
          <div class="footer__brand-name">
            <Logo className="header__logo-icon" size={28} />
            EverydayFix
          </div>
          <p class="footer__brand-desc">
            Simple solutions for everyday problems. Practical tips, tricks, and guides to make your daily life easier.
          </p>
        </div>
        <div>
          <h3 class="footer__heading">Categories</h3>
          <div class="footer__links">
            <a href="/home-living/" class="footer__link">Home & Living</a>
            <a href="/tech-internet/" class="footer__link">Tech & Internet</a>
            <a href="/kitchen-food/" class="footer__link">Kitchen & Food</a>
            <a href="/everyday-life/" class="footer__link">Everyday Life</a>
          </div>
        </div>
        <div>
          <h3 class="footer__heading">Site</h3>
          <div class="footer__links">
            <a href="/about/" class="footer__link">About Us</a>
            <a href="/contact/" class="footer__link">Contact</a>
            <a href="/docs/" class="footer__link">Documentation</a>
            <a href="/privacy-policy/" class="footer__link">Privacy Policy</a>
            <a href="/disclaimer/" class="footer__link">Disclaimer</a>
            <a href="/rss.xml" class="footer__link">RSS Feed</a>
            <a href="mailto:xuaninformatica@gmail.com" class="footer__link">xuaninformatica@gmail.com</a>
          </div>
        </div>
      </div>
      <div class="footer__bottom">
        &copy; {new Date().getFullYear()} EverydayFix. All rights reserved.
      </div>
    </div>
  </footer>

  <script>
    const toggle = document.getElementById('menu-toggle');
    const nav = document.getElementById('main-nav');
    toggle?.addEventListener('click', () => {
      nav?.classList.toggle('header__nav--open');
    });
  </script>
</body>
</html>