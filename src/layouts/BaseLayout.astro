---
interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  ogImage?: string;
}

const {
  title,
  description,
  canonicalURL = Astro.url.href,
  ogImage = 'https://everydayfix.pages.dev/og-default.png',
} = Astro.props;

const siteName = 'EverydayFix';
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;

// Determine active nav path
const currentPath = Astro.url.pathname;
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/home-living/', label: 'Home & Living' },
  { href: '/tech-internet/', label: 'Tech' },
  { href: '/kitchen-food/', label: 'Kitchen' },
  { href: '/everyday-life/', label: 'Everyday' },
  { href: '/about/', label: 'About' },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:image" content={ogImage} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <title>{fullTitle}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <style is:global>
    @import '../styles/global.css';
    @import '../styles/components.css';
  </style>
</head>
<body>
  <header class="header">
    <div class="container header__inner">
      <a href="/" class="header__logo" aria-label="EverydayFix Home">
        <span>⚡</span>
        <span>EverydayFix</span>
      </a>

      <button class="header__menu-btn" aria-label="Toggle menu" id="menu-toggle">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 12h18M3 6h18M3 18h18" />
        </svg>
      </button>

      <nav class="header__nav" id="main-nav">
        {navLinks.map((link) => {
          const isActive = link.href === '/'
            ? currentPath === '/'
            : currentPath.startsWith(link.href);
          return (
            <a
              href={link.href}
              class={`header__nav-link ${isActive ? 'header__nav-link--active' : ''}`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="footer">
    <div class="container">
      <div class="footer__grid">
        <div class="footer__brand">
          <div class="footer__brand-name">⚡ EverydayFix</div>
          <p class="footer__brand-desc">
            Simple solutions for everyday problems. Practical tips, tricks, and guides to make your daily life easier.
          </p>
        </div>
        <div>
          <h3 class="footer__heading">Categories</h3>
          <div class="footer__links">
            <a href="/home-living/" class="footer__link">Home & Living</a>
            <a href="/tech-internet/" class="footer__link">Tech & Internet</a>
            <a href="/kitchen-food/" class="footer__link">Kitchen & Food</a>
            <a href="/everyday-life/" class="footer__link">Everyday Life</a>
          </div>
        </div>
        <div>
          <h3 class="footer__heading">Site</h3>
          <div class="footer__links">
            <a href="/about/" class="footer__link">About Us</a>
            <a href="/contact/" class="footer__link">Contact</a>
            <a href="mailto:xuaninformatica@gmail.com" class="footer__link">xuaninformatica@gmail.com</a>
          </div>
        </div>
        <div>
          <h3 class="footer__heading">Legal</h3>
          <div class="footer__links">
            <a href="/privacy-policy/" class="footer__link">Privacy Policy</a>
            <a href="/disclaimer/" class="footer__link">Disclaimer</a>
          </div>
        </div>
      </div>
      <div class="footer__bottom">
        &copy; {new Date().getFullYear()} EverydayFix. All rights reserved.
      </div>
    </div>
  </footer>

  <script>
    const toggle = document.getElementById('menu-toggle');
    const nav = document.getElementById('main-nav');
    toggle?.addEventListener('click', () => {
      nav?.classList.toggle('header__nav--open');
    });
  </script>
</body>
</html>
