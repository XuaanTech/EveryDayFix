---
interface Props {
  placeholder?: string;
}

const { placeholder } = Astro.props;
const inputPlaceholder = placeholder ?? 'Search articles…';
---

<div class="search-bar" data-search>
  <svg class="search-bar__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="11" cy="11" r="8"></circle>
    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
  </svg>
  <input
    type="search"
    class="search-bar__input"
    placeholder={inputPlaceholder}
    aria-label="Search articles"
    autocomplete="off"
    role="combobox"
    aria-expanded="false"
    aria-controls="search-results"
    data-search-input
  />
  <div class="search-bar__dropdown" role="listbox" data-search-results hidden></div>
</div>

<script>
  /**
   * Client-side article search.
   * Works on every .search-bar instance on the page (header).
   */
  const wrappers = Array.from(document.querySelectorAll('[data-search]'));

  let index = null;
  const MAX_RESULTS = 8;

  async function loadIndex() {
    if (index) return index;
    try {
      const res = await fetch('/search-index.json');
      if (!res.ok) return [];
      index = await res.json();
    } catch {
      index = [];
    }
    return index;
  }

  /**
   * Score an article against the query words.
   * Each query word contributes 1 point if it appears anywhere in the
   * article's searchable text. Title matches are weighted higher.
   */
  function score(article, words) {
    let s = 0;
    for (const w of words) {
      if (!w) continue;
      if (article.title.toLowerCase().includes(w)) s += 3;
      else if (article.text.includes(w)) s += 1;
    }
    return s;
  }

  function runSearch(query, articles) {
    const q = query.trim().toLowerCase();
    if (!q) return [];
    const words = q.split(/\s+/).filter(Boolean);
    return articles
      .map((a) => ({ a, s: score(a, words) }))
      .filter((r) => r.s > 0)
      .sort((x, y) => y.s - x.s)
      .slice(0, MAX_RESULTS)
      .map((r) => r.a);
  }

  function renderResults(results, listEl) {
    if (!results.length) {
      listEl.innerHTML = '<div class="search-bar__empty">No results found</div>';
      return;
    }
    listEl.innerHTML = results
      .map(
        (r) => `
          <a class="search-bar__result" href="${r.url}" role="option">
            <span class="search-bar__result-title">${escapeHtml(r.title)}</span>
            <span class="search-bar__result-meta">
              <span class="search-bar__result-category">${escapeHtml(r.categoryName || r.category)}</span>
              ${r.description ? `<span class="search-bar__result-desc">${escapeHtml(r.description)}</span>` : ''}
            </span>
          </a>`
      )
      .join('');
  }

  function escapeHtml(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  wrappers.forEach((wrapper) => {
    const input = wrapper.querySelector('[data-search-input]');
    const list = wrapper.querySelector('[data-search-results]');
    let activeIndex = -1;

    function open() {
      list.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    }
    function close() {
      list.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      activeIndex = -1;
    }
    function highlight() {
      const items = list.querySelectorAll('.search-bar__result');
      items.forEach((el, i) => {
        el.classList.toggle('search-bar__result--active', i === activeIndex);
      });
    }

    input.addEventListener('input', async () => {
      const articles = await loadIndex();
      const results = runSearch(input.value, articles);
      renderResults(results, list);
      activeIndex = -1;
      if (input.value.trim()) open();
      else close();
    });

    input.addEventListener('focus', () => {
      if (input.value.trim()) open();
    });

    input.addEventListener('keydown', (e) => {
      const items = () => list.querySelectorAll('.search-bar__result');
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        open();
        activeIndex = Math.min(activeIndex + 1, items().length - 1);
        highlight();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        activeIndex = Math.max(activeIndex - 1, -1);
        highlight();
      } else if (e.key === 'Enter') {
        const el = items()[activeIndex];
        if (el) el.click();
      } else if (e.key === 'Escape') {
        close();
        input.blur();
      }
    });

    list.addEventListener('mousedown', (e) => e.preventDefault());
    list.addEventListener('click', (e) => {
      if (e.target.closest('.search-bar__result')) close();
    });

    document.addEventListener('click', (e) => {
      if (!wrapper.contains(e.target)) close();
    });
  });
</script>
