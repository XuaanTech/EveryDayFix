---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import categories from '../data/categories.json';
import { categoryFromPath, readingTimeFromFile } from '../lib/utils.js';

// Load all articles
const articleModules = import.meta.glob('../content/articles/**/*.mdx', { eager: true });

const articles = Object.entries(articleModules)
  .map(([path, mod]) => {
    const slug = path.split('/').pop()?.replace('.mdx', '') || '';
    const category = categoryFromPath(path);
    const categoryData = categories.find(c => c.slug === category);

    return {
      ...mod.frontmatter,
      slug,
      category,
      categoryName: categoryData?.name || category,
      readingTime: readingTimeFromFile(mod.file),
    };
  })
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const featuredArticles = articles.filter(a => a.featured).slice(0, 4);
const latestArticles = articles.slice(0, 9);

// Schema.org WebSite with SearchAction (sitelinks searchbox)
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "EverydayFix",
  "url": "https://everydayfix.pages.dev",
  "description": "Simple solutions for everyday problems. Practical tips, tricks, and guides.",
  "inLanguage": "en",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://everydayfix.pages.dev/search?q={search_term_string}",
    },
    "query-input": "required name=search_term_string",
  },
};
---

<BaseLayout
  title="Simple Solutions for Everyday Problems"
  description="Simple solutions for everyday problems. Practical tips, tricks, and step-by-step guides for home, tech, kitchen, and daily life."
>
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <h1 class="hero__title">Simple Solutions for Everyday Problems</h1>
      <p class="hero__subtitle">
        Practical tips, tricks, and step-by-step guides to fix common issues in your home, tech, kitchen, and daily life.
      </p>
      <div class="hero__categories">
        {categories.map(cat => (
          <a href={`/${cat.slug}/`} class="hero__cat-link" data-astro-prefetch="hover">
            <span>{cat.icon}</span>
            <span>{cat.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="section">
    <div class="container">
      <div class="section__header">
        <h2 class="section__title">Browse by Category</h2>
        <p class="section__subtitle">Find solutions organized by topic</p>
      </div>
      <div class="category-grid">
        {categories.map(cat => (
          <a href={`/${cat.slug}/`} class="category-card" data-astro-prefetch="hover">
            <span class="category-card__icon">{cat.icon}</span>
            <div class="category-card__info">
              <h3 class="category-card__name">{cat.name}</h3>
              <p class="category-card__desc">{cat.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Articles -->
  <section class="featured-section">
    <div class="container">
      <div class="section__header">
        <h2 class="featured-section__title">Featured Guides</h2>
        <p class="featured-section__subtitle">Our most helpful solutions</p>
      </div>
      <div class="featured-grid">
        {featuredArticles.map(article => (
          <ArticleCard
            title={article.title}
            description={article.description}
            category={article.category}
            categoryName={article.categoryName}
            slug={article.slug}
            date={article.date}
            readingTime={article.readingTime}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Latest Articles -->
  <section class="section">
    <div class="container">
      <div class="section__header">
        <h2 class="section__title">Latest Articles</h2>
        <p class="section__subtitle">Fresh solutions and tips</p>
      </div>
      <div class="article-grid">
        {latestArticles.map(article => (
          <ArticleCard
            title={article.title}
            description={article.description}
            category={article.category}
            categoryName={article.categoryName}
            slug={article.slug}
            date={article.date}
            readingTime={article.readingTime}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>