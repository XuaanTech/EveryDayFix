---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQSection from '../../components/FAQSection.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import ArticleDisclaimer from '../../components/ArticleDisclaimer.astro';
import categories from '../../data/categories.json';
import { readingTimeFromFile, categoryFromPath } from '../../lib/utils.js';

export async function getStaticPaths() {
  const articleModules = import.meta.glob('../../content/articles/**/*.mdx', { eager: true });

  const paths = [];

  for (const [path, mod] of Object.entries(articleModules)) {
    const category = categoryFromPath(path);
    const slug = path.split('/').pop()?.replace('.mdx', '') || '';
    const categoryData = categories.find(c => c.slug === category);

    if (categoryData) {
      paths.push({
        params: { category, slug },
        props: {
          ...mod.frontmatter,
          slug,
          category,
          categoryData,
          Content: mod.default,
          filePath: mod.file,
        },
      });
    }
  }

  return paths;
}

const { title, description, category, categoryData, slug, date, updated, author, faqs, steps, tags, Content, filePath } = Astro.props;
const siteUrl = 'https://everydayfix.pages.dev';
const canonicalURL = `${siteUrl}/${category}/${slug}/`;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdated = updated ? new Date(updated).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}) : formattedDate;

// Real reading time computed from source content
const readingTime = readingTimeFromFile(filePath);

// Robust category detection + related article scoring
const articleModules = import.meta.glob('../../content/articles/**/*.mdx', { eager: true });

interface RelatedCandidate {
  title: string;
  category: string;
  categoryName: string;
  slug: string;
  tags: string[];
  score: number;
}

const currentTags: string[] = Array.isArray(tags) ? tags : [];
const currentWords = new Set(title.toLowerCase().split(/\s+/).filter((w: string) => w.length > 3));

const relatedArticles: RelatedCandidate[] = Object.entries(articleModules)
  .filter(([path]) => categoryFromPath(path) === category && !path.endsWith(`/${slug}.mdx`))
  .map(([path, mod]) => {
    const relatedSlug = path.split('/').pop()?.replace('.mdx', '') || '';
    const relatedTags: string[] = Array.isArray(mod.frontmatter.tags) ? mod.frontmatter.tags : [];

    // Relevance scoring: shared tags (+3), shared title words (+2)
    let score = 0;
    for (const t of relatedTags) {
      if (currentTags.includes(t)) score += 3;
    }
    const relatedWords = new Set((mod.frontmatter.title || '').toLowerCase().split(/\s+/).filter((w: string) => w.length > 3));
    for (const w of relatedWords) {
      if (currentWords.has(w)) score += 2;
    }

    return {
      title: mod.frontmatter.title || relatedSlug,
      category,
      categoryName: categoryData.name,
      slug: relatedSlug,
      tags: relatedTags,
      score,
    };
  })
  .sort((a, b) => b.score - a.score)
  .slice(0, 3);

// Article schema — author is Person, publisher is Organization
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "url": canonicalURL,
  "datePublished": date,
  "dateModified": updated || date,
  "author": {
    "@type": "Person",
    "@id": `${siteUrl}/#author`,
    "name": author || "EverydayFix Team",
    "url": `${siteUrl}/about/`,
  },
  "publisher": {
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    "name": "EverydayFix",
    "url": siteUrl,
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL,
  },
  "inLanguage": "en",
};

// HowTo schema (if steps are provided)
const howToSchema = steps ? {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": title,
  "description": description,
  "step": steps.map((step: string, i: number) => ({
    "@type": "HowToStep",
    "position": i + 1,
    "text": step,
  })),
} : null;

---

<BaseLayout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  ogType="article"
  articlePublishedTime={date}
  articleModifiedTime={updated || date}
  articleAuthor={author || 'EverydayFix Team'}
  articleSection={categoryData.name}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {howToSchema && <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />}

  <div class="container container--narrow">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: categoryData.name, href: `/${category}/` },
      { label: title },
    ]} />

    <header class="article-header">
      <div class="article-header__meta">
        <span class={`badge badge--${category}`}>{categoryData.name}</span>
        <span class="article-header__author">By {author || 'EverydayFix Team'}</span>
        <span class="article-header__reading-time">{readingTime}</span>
        <time datetime={date}>Published {formattedDate}</time>
        {updated && updated !== date && (
          <time datetime={updated}>Updated {formattedUpdated}</time>
        )}
      </div>
      <p class="article-header__reviewed">Reviewed by the EverydayFix Editorial Team · Last reviewed {formattedUpdated}</p>
    </header>

    <article class="article-content">
      <ArticleDisclaimer category={category} />
      <Content />
    </article>

    {faqs && faqs.length > 0 && (
      <FAQSection faqs={faqs} />
    )}

    <RelatedArticles articles={relatedArticles} />
  </div>
</BaseLayout>